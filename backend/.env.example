# HTTP (Railway injects PORT in production)
PORT=3000

# JWT — generate a long random value (never commit the real key)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Mock admin (Step 1). Loaded from env only — never hardcode in source.
ADMIN_EMAIL=admin@golkhune.local
ADMIN_PASSWORD=replace-with-a-strong-password

# SQLite file (created on first start)
SQLITE_PATH=data/golkhune.db

# Optional PostgreSQL later. Empty = env-backed mock admin for login.
DATABASE_URL=

# Placeholder live camera URL for the public dashboard
CAMERA_STREAM_URL=https://example.com/live/golkhune-camera

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
